/* 配色与网页端一致: 暗色底, 涨红跌绿 (A 股口径) */
page {
  --bg: #0f1115;
  --panel: #171a21;
  --border: #262a33;
  --text: #e6e8eb;
  --muted: #8a8f98;
  --accent: #a78bfa;
  --up: #c74040;
  --down: #2d9b65;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.mono { font-family: Menlo, "SF Mono", Consolas, monospace; }
.muted { color: var(--muted); }
.up { color: var(--up); }
.down { color: var(--down); }
.flat { color: var(--muted); }

.panel {
  margin: 20rpx 24rpx;
  background: var(--panel);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--border);
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 30rpx; }
.row-sub { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.row-right { text-align: right; margin-left: 20rpx; }

.status {
  padding: 60rpx 32rpx;
  text-align: center;
  color: var(--muted);
}
.status.error { color: var(--up); }

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.btn {
  background: var(--accent);
  color: #0f1115;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
}
.btn.ghost {
  background: transparent;
  color: var(--accent);
  border: 1rpx solid var(--accent);
}
.btn.disabled { opacity: 0.5; }

.chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--border);
  color: var(--muted);
  font-size: 24rpx;
}
.chip.active {
  border-color: var(--accent);
  color: var(--accent);
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  background: rgba(167, 139, 250, 0.15);
  color: var(--accent);
}
.tag.buy { background: rgba(199, 64, 64, 0.15); color: var(--up); }
.tag.sell { background: rgba(45, 155, 101, 0.15); color: var(--down); }
